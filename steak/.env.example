# OpenClawd Steak / Agent Staking local environment

# Devnet is the default. Use a private RPC endpoint by exporting this locally,
# but do not commit populated API keys.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Local dev wallet. Do not commit wallet JSON files.
ANCHOR_WALLET=~/.config/solana/id.json

# Current OpenClawd Agent Staking devnet program id.
OPENCLAWD_AGENT_STAKING_PROGRAM_ID=D5MLxrKAnppBVLuukKQzQGTMSfEwBqWCDPGAhGhthdLP

# Required for stake/unstake commands against a real Metaplex Core collection.
OPENCLAWD_AGENT_COLLECTION=

# Mainnet operations are blocked unless this is set explicitly in the shell.
OPENCLAWD_ENABLE_MAINNET=0
