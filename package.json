{
  "name": "openclawd",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "OpenClawd monorepo for Solana-native AI agents, payments, MCP tools, and developer surfaces.",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-agent-registry": "^0.2.5",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "ulid": "^2.4.0"
  },
  "workspaces": [
    "packages/adapters/eleven-labs",
    "packages/adapters/langchain",
    "packages/adapters/llamaindex",
    "packages/adapters/mastra",
    "packages/adapters/model-context-protocol",
    "packages/adapters/openclawd",
    "packages/adapters/vercel-ai",
    "packages",
    "packages/agents-x402-solana",
    "packages/agentwallet",
    "packages/api-client",
    "packages/clawd-wallet",
    "packages/cli",
    "packages/api-client/client",
    "packages/config",
    "packages/core",
    "packages/crossmint-agentic-wallet",
    "packages/honcho-bridge",
    "packages/membrain-types",
    "packages/memory-host-sdk",
    "packages/percolator",
    "packages/plugin-package-contract",
    "packages/plugin-bootstrap",
    "packages/plugin-sql",
    "packages/plugin-sdk",
    "packages/server",
    "packages/service-registry",
    "openclawd-framework",
    "openclawd-framework/packages/clawd",
    "openclawd-framework/packages/cli-standalone",
    "gateway",
    "api-registrar",
    "apps/clawd-code-cli",
    "apps/clawd-tui",
    "apps/clawdrouter",
    "mcp",
    "mcp/crossmint-mcp",
    "mcp/vault-mcp",
    "mcp/wurk-mcp",
    "moltbook-agent",
    "apps/clawd-vault-master",
    "extensions/discord",
    "extensions/imessage",
    "extensions/memory-core",
    "extensions/signal",
    "extensions/slack",
    "extensions/whatsapp",
    "automaton-main",
    "automaton-main/packages/cli",
    "chrome-extension/core",
    "chrome-extension/llms",
    "chrome-extension/page-controller",
    "chrome-extension/page-agent",
    "chrome-extension/theme",
    "chrome-extension/ui",
    "chrome-extension/wallet",
    "chrome-extension/mcp"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "install:all": "npm run install:agents && npm run install:router && npm run install:registrar && npm run install:cli && npm run install:hub && npm run install:wallet && npm run install:framework && npm run install:gateway && npm run install:plugin-delivery && npm run install:membrain-ts && npm run install:automaton && npm run install:payments",
    "install:automaton": "cd automaton-main && (pnpm install --no-frozen-lockfile || npm install --no-audit --no-fund)",
    "install:pagent": "for d in chrome-extension/theme chrome-extension/wallet chrome-extension/page-controller chrome-extension/llms chrome-extension/core chrome-extension/ui chrome-extension/page-agent chrome-extension/mcp; do (cd \"$d\" && npm install --no-audit --no-fund --no-workspaces --install-strategy=hoisted --legacy-peer-deps) || exit 1; done",
    "build:pagent": "for d in chrome-extension/theme chrome-extension/wallet chrome-extension/page-controller chrome-extension/llms chrome-extension/core chrome-extension/ui chrome-extension/page-agent; do (cd \"$d\" && npm run --if-present build) || exit 1; done",
    "install:agents": "cd agents && npm install --no-audit --no-fund",
    "install:router": "cd apps/clawdrouter && npm install --no-audit --no-fund",
    "install:registrar": "cd api-registrar && npm install --no-audit --no-fund",
    "install:cli": "cd apps/clawd-code-cli && npm install --no-audit --no-fund",
    "install:hub": "cd apps/clawdhub && npm install --no-audit --no-fund",
    "install:wallet": "cd packages/clawd-wallet && npm install --no-audit --no-fund",
    "install:framework": "cd openclawd-framework && npm install --no-audit --no-fund",
    "install:gateway": "cd gateway && npm install --no-audit --no-fund",
    "install:plugin-delivery": "node scripts/install-plugin-delivery.mjs",
    "install:membrain-ts": "cd packages/membrain/clients/typescript && npm install --no-audit --no-fund",
    "install:payments": "cd payments/pay-main/typescript && pnpm install --no-frozen-lockfile",
    "install:vault": "cd apps/clawd-vault-master && npm install --no-audit --no-fund --if-present",
    "build:catalog": "cd agents && node build-catalog.cjs",
    "build:membrain": "cd packages/membrain && make build",
    "build:membrain-ts": "cd packages/membrain/clients/typescript && npm run build",
    "build:framework": "npm --prefix openclawd-framework run build",
    "build:clawd-code": "npm --prefix openclawd-framework/packages/clawd run build",
    "build:gateway": "npm --prefix gateway run build",
    "build:plugin-delivery": "node scripts/build-plugin-delivery.mjs",
    "build:percolator": "npm --prefix packages/percolator run build",
    "build:agentwallet": "npm --prefix packages/agentwallet run build",
    "build:clawd-wallet": "npm --prefix packages/clawd-wallet run build",
    "build:honcho-bridge": "npm --prefix packages/honcho-bridge run build",
    "build:membrain-types": "npm --prefix packages/membrain-types run build",
    "build:service-registry": "npm --prefix packages/service-registry run build",
    "build:blockchain-buddies-cli": "npm --prefix apps/blockchain_buddies/packages/petdex-cli run build",
    "build:payments": "cd payments/pay-main/typescript && pnpm --dir packages/solana-pay/core build",
    "build:openclawd-go": "cd cmd/openclawd-go && go build -o openclawd-go .",
    "typecheck:payments": "cd payments/pay-main/typescript && pnpm --dir packages/solana-pay/core typecheck",
    "payments:merchant": "node scripts/openclawd-merchant.mjs",
    "typecheck:blockchain-buddies-cli": "npm --prefix apps/blockchain_buddies/packages/petdex-cli run typecheck",
    "build:automaton": "cd automaton-main && (pnpm -r build || npm run build)",
    "build:release": "npm run build:membrain-types && npm run build:honcho-bridge && npm run build:framework && npm run build:clawd-code && npm run build:agentwallet && npm run build:clawd-wallet && npm run build:percolator && npm run build:blockchain-buddies-cli && npm run build:payments && npm run build:automaton && npm run build:pagent",
    "test:membrain": "cd packages/membrain && make test",
    "lint": "npm --prefix apps/clawdrouter run lint --if-present && npm --prefix api-registrar run lint --if-present && npm --prefix apps/clawd-code-cli run lint --if-present",
    "typecheck": "npm --prefix apps/clawdrouter run typecheck --if-present && npm --prefix api-registrar run typecheck --if-present && npm --prefix apps/clawd-code-cli run typecheck --if-present",
    "dev:router": "cd apps/clawdrouter && npm run dev",
    "dev:registrar": "cd api-registrar && npm run dev",
    "dev:cli": "cd apps/clawd-code-cli && npm run dev",
    "dev:framework": "cd openclawd-framework && npm run dev",
    "dev:membrain": "cd packages/membrain && ./bin/membraned",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "guard:staged": "node scripts/guard-secrets.mjs --staged",
    "guard:worktree": "node scripts/guard-secrets.mjs --worktree",
    "release:check": "node scripts/release-check.mjs && node scripts/release-dist-check.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:wire": "node scripts/release-wire.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "upload:browseruse": "node scripts/upload-to-browseruse.mjs",
    "upload:browseruse:dry": "node scripts/upload-to-browseruse.mjs --dry-run"
  },
  "homepage": "https://solanaclawd.com"
}
