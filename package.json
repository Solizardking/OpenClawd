{
  "name": "openclawd",
  "version": "1.0.0",
  "description": "OpenClawd — Financial AI Agent Platform for Solana DeFi",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "check": "pnpm typecheck && pnpm lint"
  },
  "keywords": [
    "solana",
    "ai-agent",
    "defi",
    "trading",
    "jupiter",
    "pump.fun"
