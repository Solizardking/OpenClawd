{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2017",
    "lib": ["dom", "esnext"],
    "declaration": true,
    "sourceMap": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@openclawdsolana/chat-plugins-gateway": ["src"],
      "@openclawdsolana/plugin-sdk": ["../sdk"],
      "@openclawdsolana/plugin-sdk/openapi": ["../sdk/openapi"],
      "@openclawdsolana/plugin-sdk/client": ["../sdk/client"],
      "@openclawdsolana/plugin-sdk/schema": ["../sdk/schema"]
    }
  },
  "include": ["types", "api", "src", "*.ts", "tests"]
}

