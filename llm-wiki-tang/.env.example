# =============================================================================
# OpenClawd AutoResearch Wiki — environment variables
# =============================================================================

# --- Database / Supabase --------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# --- Stage / URLs --------------------------------------------------------
STAGE=dev
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
MCP_URL=

# --- Solana data services -----------------------------------------------
# Helius — RPC + DAS API + Wallet API (parsed transactions, balances, names).
# Get a key at https://www.helius.dev/. Either supply the bare key and let the
# server build the URL, or paste the full URL with ?api-key= in HELIUS_RPC_URL.
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_WSS_URL=

# Birdeye — token / pair / wallet data. Get one at https://bds.birdeye.so/
BIRDEYE_API_KEY=

# Optional secondary source for trending/new tokens
SOLANA_TRACKER_API_KEY=

# --- Research autoloop --------------------------------------------------
# When true, the FastAPI process starts the autonomous research scheduler at
# boot. Otherwise the loop only runs when /api/v1/research/autoloop/start is
# called (e.g. from the TUI: /autoloop start).
RESEARCH_AUTOLOOP_ENABLED=false
RESEARCH_AUTOLOOP_INTERVAL_SECONDS=1800
RESEARCH_AUTOLOOP_MAX_CONCURRENT=3

# --- LLM / agent runtime ------------------------------------------------
OPENROUTER_API_KEY=
XAI_API_KEY=
AGENT_MODEL=anthropic/claude-opus-4.7
AGENT_MAX_STEPS=20
AGENT_MAX_COST=1.0

# --- Embeddings / retrieval --------------------------------------------
VOYAGE_API_KEY=
TURBOPUFFER_API_KEY=
MISTRAL_API_KEY=

# --- AWS / S3 (document storage) --------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# --- Frontend (web/) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MCP_URL=

# --- Observability ------------------------------------------------------
SENTRY_DSN=
LOGFIRE_TOKEN=

# --- Honcho (conversational reasoning) ---------------------------------
# Used by services/research_orchestrator.py + skills/pumpfun-token-scanner
# to feed conclusions into Membrain. See packages/honcho-bridge/.env.example
# for the full variable set + webhook fan-out shape.
HONCHO_ENABLED=true
HONCHO_URL=https://api.honcho.dev
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=openclawd
HONCHO_AGENT_PEER_ID=openclawd
HONCHO_REASONING_LEVEL=low
HONCHO_CONTEXT_TOKENS=4000
HONCHO_CONTEXT_SUMMARY=true
HONCHO_SYNC_MESSAGES=true
