{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "types": ["node", "bun"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@openclawdsolana/core": ["packages/src/index.ts"],
      "@openclawdsolana/core/*": ["packages/src/*"],
      "@openclawdsolana/plugin-sql": ["../../packages/plugin-sql/src/index.ts"],
      "@openclawdsolana/plugin-sql/*": ["../../packages/plugin-sql/src/*"],
      "@openclawdsolana/plugin-bootstrap": ["../../packages/plugin-bootstrap/src/index.ts"],
      "@openclawdsolana/plugin-bootstrap/*": ["../../packages/plugin-bootstrap/src/*"],
      "@openclawdsolana/api-client": ["../../packages/api-client/src/index.ts"],
      "@openclawdsolana/api-client/*": ["../../packages/api-client/src/*"]
    }
  },
  "include": ["./**/*.ts", "../packages/src/**/*.ts"]
}
