# OpenClawd local environment template.
# Copy to `.env.local` and fill in real values locally. Never commit `.env.local`.

# Core model + Solana data
OPENROUTER_API_KEY=
HELIUS_API_KEY=
HELIUS_RPC_URL=
SOLANA_RPC_URL=
BIRDEYE_API_KEY=
JUPITER_API_KEY=

# Optional signed execution. Use read-only mode until you explicitly need this.
SOLANA_PRIVATE_KEY=
SOLANA_PUBLIC_KEY=

# Optional ClawdBot channels
TELEGRAM_BOT_TOKEN=
DISCORD_API_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Optional Phala TEE derivation for ClawdBot
TEE_MODE=OFF
TEE_VENDOR=phala
WALLET_SECRET_SALT=

# Optional Honcho memory/reasoning
HONCHO_ENABLED=false
HONCHO_URL=https://api.honcho.dev
HONCHO_WORKSPACE_ID=openclawd
HONCHO_AGENT_PEER_ID=openclawd
HONCHO_REASONING_LEVEL=low
HONCHO_CONTEXT_TOKENS=4000
HONCHO_CONTEXT_SUMMARY=true
HONCHO_SYNC_MESSAGES=true
HONCHO_WEBHOOK_SECRET=

# Optional app surfaces
OPENCLAWD_API_BASE=
OPENCLAWD_GATEWAY_BASE=
OPENCLAWD_MARKETPLACE=https://hub.solanaclawd.com

# Blockchain Buddies deployment lives in `blockchain_buddies/.env.example`.
