{
  "manifest_version": 3,
  "name": "OpenClawd Browser Bridge",
  "version": "0.2.0",
  "description": "Attach OpenClawd to Chrome via CDP relay, Gateway HTTP, and a local Solana agent wallet for on-chain signing.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "tabs", "activeTab", "storage", "notifications", "contextMenus"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://solanaclawd.com/*",
    "https://gateway.solanaclawd.com/*",
    "https://install.solanaclawd.com/*",
    "https://mainnet.helius-rpc.com/*",
    "https://public-api.birdeye.so/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "OpenClawd Browser Bridge — click to attach the active tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
