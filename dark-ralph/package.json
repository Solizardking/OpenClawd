{
  "name": "@darkralph/tui",
  "version": "1.0.0",
  "description": "Dark Ralph TUI - Recursive Autonomous Solana Intelligence Agent with Bloomberg-style terminal interface",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dark-ralph": "./dist/cli.js",
    "ralph": "./dist/cli.js",
    "ralph-tui": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build src/cli.tsx --outdir dist --target node",
    "build:lib": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/cli.js",
    "run": "bun run src/cli.tsx run",
    "setup": "bun run src/cli.tsx setup",
    "status": "bun run src/cli.tsx status",
    "wallet": "bun run src/cli.tsx wallet",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build && bun run build:lib"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "ink-select-input": "^5.0.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-box": "^2.0.0",
    "react": "^18.2.0",
    "@solana/web3.js": "^1.87.6",
    "@solana/spl-token": "^0.3.9",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "figlet": "^1.7.0",
    "boxen": "^7.1.1",
    "ora": "^7.0.1",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "conf": "^12.0.0",
    "openai": "^4.20.1",
    "eventsource-parser": "^1.1.1",
    "node-fetch": "^3.3.2",
    "ws": "^8.14.2",
    "date-fns": "^2.30.0",
    "cli-table3": "^0.6.3",
    "gradient-string": "^2.0.2",
    "terminal-link": "^3.0.0",
    "update-notifier": "^6.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.37",
    "@types/figlet": "^1.5.8",
    "@types/gradient-string": "^1.1.5",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.2",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "bun-types": "latest"
  },
  "keywords": [
    "solana",
    "ai-agent",
    "tui",
    "terminal",
    "crypto",
    "trading",
    "autonomous",
    "helius",
    "birdeye",
    "grok",
    "perplexity",
    "bloomberg",
    "dark-ralph"
  ],
  "author": "Dark Ralph Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darkralph/ralph-tui"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
