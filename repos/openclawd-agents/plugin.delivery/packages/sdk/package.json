{
  "name": "@speraxplugin-sdk",
  "version": "1.0.0",
  "description": "SperaxOS Plugin SDK - Build plugins for SperaxOS",
  "keywords": [
    "sperax",
    "speraxos",
    "sdk",
    "plugin",
    "chat-plugin"
  ],
  "homepage": "https:github.comsolizardkingplugin.delivery",
  "repository": {
    "type": "git",
    "url": "https:github.comsolizardkingplugin.delivery.git"
  },
  "license": "MIT",
  "author": "Sperax <contact@sperax.io>",
  "sideEffects": false,
  "main": ".index.ts",
  "types": ".index.ts",
  "exports": {
    ".": {
      "import": ".index.ts",
      "require": ".index.ts",
      "types": ".index.ts"
    },
    ".client": {
      "import": ".clientindex.ts",
      "types": ".clientindex.ts"
    },
    ".schema": {
      "import": ".schemaindex.ts",
      "types": ".schemaindex.ts"
    },
    ".openapi": {
      "import": ".openapiindex.ts",
      "types": ".openapiindex.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@apidevtoolsswagger-parser": "^10.1.0",
    "@typesjson-schema": "^7.0.14",
    "openapi-jsonschema-parameters": "^12.1.3",
    "openapi-types": "^12.1.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@typesreact": "^18",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}

