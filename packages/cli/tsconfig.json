{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "isolatedModules": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ESNext",
    "types": ["node", "bun"],
    "paths": {
      "@/src/*": ["./src/*"],
      "@openclawdsolana/core": ["../src"],
      "@openclawdsolana/core/*": ["../src/*"],
      "@openclawdsolana/api-client": ["../api-client/src"],
      "@openclawdsolana/api-client/*": ["../api-client/src/*"]
    },
    "rootDir": "../",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "jsx": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "incremental": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*", "../src/**/*", "../api-client/src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "../api-client/src/**/*.test.ts",
    "../api-client/src/**/__tests__/**",
    "../api-client/src/__tests__/**",
    "../src/**/*.test.ts",
    "../src/**/__tests__/**",
    "../src/__tests__/**",
    "../src/test_resources/**"
  ]
}
