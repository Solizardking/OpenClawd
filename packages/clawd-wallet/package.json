{
  "name": "@openclawdsolana/clawd-wallet",
  "version": "0.1.0",
  "description": "Clawd Wallet — Solana wallet + Jupiter swap core for the openclawd agent ecosystem. (React/CLI/agent surfaces ship in a future release.)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@solana/kit": "^2.0.0",
    "@jup-ag/api": "^6.0.20",
    "bs58": "^6.0.0",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "solana",
    "wallet",
    "swap",
    "trading",
    "jupiter",
    "clawd",
    "openclawd",
    "agentic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://solanaclawd.com",
    "directory": "packages/clawd-wallet"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
