    "clawd",
    "agent",
    "trading",
    "ooda",
    "privy",
    "jupiter",
    "helius",
    "clawdrouter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawdsolana/OpenClawd.git",
    "directory": "npm/openclawd-cli"
  },
  "homepage": "https://solanaclawd.com",
  "bugs": {
    "url": "https://github.com/clawdsolana/OpenClawd/issues"
  }
