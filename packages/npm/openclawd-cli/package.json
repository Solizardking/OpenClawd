{
  "name": "@openclawdsolana/cli",
  "version": "0.1.0",
  "description": "OpenClawd CLI bootstrapper — installs and runs the Solana-native AI agent runtime with ClawdRouter, Helius, and Jupiter integration.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "clawd": "bin/clawd.mjs",
    "openclawd": "bin/clawd.mjs",
    "openclawdsolana": "bin/clawd.mjs"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "scripts": {
