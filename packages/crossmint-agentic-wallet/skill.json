{
  "name": "crossmint-agentic-wallet",
  "displayName": "Crossmint Agentic Wallet",
  "version": "1.3.0",
  "description": "Create non-custodial Solana wallets for AI agents with e-commerce, Jupiter swaps, agent-to-agent payments, and Google UCP support",
  "author": "MAWDos",
  "category": "blockchain",
  "tags": ["solana", "wallet", "crossmint", "ai-agent", "non-custodial", "mpc", "e-commerce", "jupiter", "agent-commerce", "ucp", "google-pay"],

  "entry": "dist/index.js",

  "envVars": {
    "CROSSMINT_SERVERSIDE_API_KEY": {
      "required": true,
      "description": "Crossmint server-side API key (starts with sk_staging_ or sk_production_)"
    },
    "CROSSMINT_CLIENTSIDE_API_KEY": {
      "required": false,
      "description": "Crossmint client-side API key (optional, for frontend integrations)"
    }
  },

  "tools": [
    {
      "name": "create_wallet",
      "description": "Create a new non-custodial Solana wallet for an AI agent",
      "parameters": {
        "identifier": "string (required) - Email, phone, or agent ID",
        "chain": "string (optional) - 'solana' or 'solana-devnet'",
        "alias": "string (optional) - Wallet alias like 'trading' or 'treasury'"
      }
    },
    {
      "name": "get_or_create_wallet",
      "description": "Get existing wallet or create a new one (idempotent)",
      "parameters": {
        "identifier": "string (required)",
        "chain": "string (optional)",
        "alias": "string (optional)"
      }
    },
    {
      "name": "get_wallet",
      "description": "Get an existing wallet by identifier",
      "parameters": {
        "identifier": "string (required)",
        "chain": "string (optional)"
      }
    },
    {
      "name": "get_balances",
      "description": "Get wallet token balances (SOL, USDC, etc.)",
      "parameters": {
        "identifier": "string (required)",
        "chain": "string (optional)",
        "tokens": "array (optional) - Token symbols to check"
      }
    },
    {
      "name": "transfer_sol",
      "description": "Transfer SOL to another wallet",
      "parameters": {
        "from_identifier": "string (required)",
        "to_address": "string (required) - Recipient Solana address",
        "amount": "string (required) - Amount in SOL",
        "chain": "string (optional)"
      }
    },
    {
      "name": "transfer_tokens",
      "description": "Transfer SPL tokens to another wallet",
      "parameters": {
        "from_identifier": "string (required)",
        "to_address": "string (required)",
        "token": "string (required) - Token symbol or mint",
        "amount": "string (required)",
        "chain": "string (optional)"
      }
    },
    {
      "name": "fund_wallet_staging",
      "description": "Fund wallet with testnet USDXM (staging only)",
      "parameters": {
        "identifier": "string (required)",
        "amount": "number (optional, default: 10)"
      }
    },
    {
      "name": "fund_wallet_faucet",
      "description": "Request SOL airdrop from Solana devnet faucet (max 2 SOL)",
      "parameters": {
        "address": "string (required) - Solana wallet address",
        "amount": "number (optional, default: 1, max: 2)"
      }
    },
    {
      "name": "get_swap_quote",
      "description": "Get a quote for swapping tokens via Jupiter",
      "parameters": {
        "input_mint": "string (required) - SOL, USDC, or mint address",
        "output_mint": "string (required)",
        "amount": "string (required) - Amount in smallest unit",
        "slippage_bps": "number (optional, default: 50)"
      }
    },
    {
      "name": "swap_tokens",
      "description": "Swap tokens using Jupiter aggregator",
      "parameters": {
        "identifier": "string (required)",
        "input_mint": "string (required)",
        "output_mint": "string (required)",
        "amount": "string (required)",
        "slippage_bps": "number (optional)",
        "chain": "string (optional)"
      }
    },
    {
      "name": "post_to_moltbook",
      "description": "Share agent achievements on moltbook.com",
      "parameters": {
        "content": "string (required) - Post content (max 500 chars)",
        "wallet_address": "string (optional)",
        "tags": "array (optional)"
      }
    },
    {
      "name": "create_order",
      "description": "Create an order to purchase products from Amazon, Shopify, or any website",
      "parameters": {
        "payer_address": "string (required) - Wallet address to pay from",
        "product_url": "string (required) - Product URL",
        "recipient_email": "string (required)",
        "recipient_name": "string (required)",
        "address_line1": "string (required)",
        "city": "string (required)",
        "state": "string (required)",
        "postal_code": "string (required)",
        "payment_currency": "string (optional) - usdc or credit"
      }
    },
    {
      "name": "complete_order_payment",
      "description": "Complete payment for an order",
      "parameters": {
        "identifier": "string (required)",
        "order_id": "string (required)",
        "serialized_transaction": "string (required)"
      }
    },
    {
      "name": "get_order",
      "description": "Get order status and details",
      "parameters": {
        "order_id": "string (required)"
      }
    },
    {
      "name": "list_orders",
      "description": "List orders for an email address",
      "parameters": {
        "email": "string (optional)",
        "status": "string (optional)",
        "limit": "number (optional)"
      }
    },
    {
      "name": "get_product_quote",
      "description": "Get price quote for a product URL",
      "parameters": {
        "product_url": "string (required)",
        "variant": "string (optional)"
      }
    },
    {
      "name": "agent_to_agent_transfer",
      "description": "Transfer USDC between AI agent wallets",
      "parameters": {
        "from_identifier": "string (required)",
        "to_identifier": "string (required)",
        "amount": "string (required)",
        "memo": "string (optional)"
      }
    }
  ],

  "examples": [
    {
      "description": "Create a wallet for an AI trading agent",
      "tool": "create_wallet",
      "input": {
        "identifier": "trading-agent-001",
        "chain": "solana-devnet",
        "alias": "trading"
      }
    },
    {
      "description": "Fund the agent wallet with testnet tokens",
      "tool": "fund_wallet_staging",
      "input": {
        "identifier": "trading-agent-001",
        "amount": 100
      }
    },
    {
      "description": "Check wallet balances",
      "tool": "get_balances",
      "input": {
        "identifier": "trading-agent-001",
        "chain": "solana-devnet"
      }
    },
    {
      "description": "Purchase a product from Amazon",
      "tool": "create_order",
      "input": {
        "payer_address": "0x1234...",
        "product_url": "https://www.amazon.com/product/dp/B00ABC123",
        "recipient_email": "user@example.com",
        "recipient_name": "John Doe",
        "address_line1": "123 Main St",
        "city": "New York",
        "state": "NY",
        "postal_code": "10001"
      }
    },
    {
      "description": "Pay another agent for a service",
      "tool": "agent_to_agent_transfer",
      "input": {
        "from_identifier": "agent-001",
        "to_identifier": "data-agent-002",
        "amount": "5.00",
        "memo": "Payment for market analysis"
      }
    }
  ]
}
