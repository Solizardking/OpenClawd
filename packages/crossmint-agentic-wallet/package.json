{
  "name": "@openclawdsolana/crossmint-agentic-wallet",
  "version": "1.3.0",
  "description": "Non-custodial Solana wallet creation for AI agents using Crossmint MPC infrastructure",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skill.json",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "wallet",
    "crossmint",
    "ai-agent",
    "mcp",
    "skill",
    "non-custodial",
    "mpc",
    "blockchain",
    "web3",
    "agent",
    "autonomous",
    "agentic",
    "openclawd"
  ],
  "author": "OpenClawd Solana",
  "contributors": [
    "MAWDos (original author — https://github.com/mawdos/crossmint-agentic-wallet)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://solanaclawd.com",
    "directory": "packages/crossmint-agentic-wallet"
  },
  "homepage": "https://solanaclawd.com",
  "bugs": {
    "url": "https://solanaclawd.com"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "openclaw": {
    "skillKey": "crossmint-agentic-wallet",
    "displayName": "Crossmint Agentic Wallet",
    "description": "Create and manage non-custodial Solana wallets for AI agents",
    "category": "blockchain",
    "envVars": {
      "primary": "CROSSMINT_SERVERSIDE_API_KEY",
      "optional": ["CROSSMINT_CLIENTSIDE_API_KEY"]
    },
    "tools": [
      "create_wallet",
      "get_or_create_wallet",
      "get_wallet",
      "get_balances",
      "transfer_tokens",
      "transfer_sol",
      "fund_wallet_staging"
    ]
  }
}
