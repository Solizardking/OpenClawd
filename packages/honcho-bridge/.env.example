# =============================================================================
# Honcho integration for OpenClawd
# =============================================================================
#
# Honcho is the conversational/peer reasoning layer used across the OpenClawd
# build (gateway, automaton, llm-wiki-tang, services/pump-scanner-cron,
# clawdhub, skills/pumpfun-token-scanner).
#
# Get an API key at https://app.honcho.dev — first $100 of usage is free.
# This file documents every variable read by @openclawdsolana/honcho-bridge,
# packages/memory-host-sdk, and the gateway HTTP server. NEVER commit a real
# key — populate the values in your local .env (gitignored) or your hosting
# provider's secret manager.

# ── Core ───────────────────────────────────────────────────────────────────
HONCHO_ENABLED=true
HONCHO_URL=https://api.honcho.dev
HONCHO_API_KEY=hch-v3-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HONCHO_WORKSPACE_ID=openclawd
HONCHO_AGENT_PEER_ID=openclawd

# ── Reasoning + context tuning ─────────────────────────────────────────────
# minimal | low | medium | high | max — applied to dialectic + summary
HONCHO_REASONING_LEVEL=low
HONCHO_CONTEXT_TOKENS=4000
HONCHO_CONTEXT_SUMMARY=true
HONCHO_SYNC_MESSAGES=true

# ── Webhook fan-out (up to 4 channels) ─────────────────────────────────────
# Each webhook has its own HMAC secret so a compromised endpoint can be
# rotated independently. The gateway's /api/honcho/webhook route uses
# the secret matching the inbound `workspace_id` claim, falling back to
# HONCHO_WEBHOOK_SECRET.
HONCHO_WEBHOOK_SECRET=hch-webhook-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

HONCHO_WEBHOOK1_URL=https://solanaclawd.com/webhook
HONCHO_WEBHOOK1_SECRET=hch-webhook-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HONCHO_WEBHOOK1_WORKSPACE=pumpfun

HONCHO_WEBHOOK2_URL=https://solanaclawd.com/webhook/chat
HONCHO_WEBHOOK2_SECRET=hch-webhook-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HONCHO_WEBHOOK2_WORKSPACE=pumpfun

HONCHO_WEBHOOK3_URL=https://solanaclawd.com/webhook/openclawd
HONCHO_WEBHOOK3_SECRET=hch-webhook-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HONCHO_WEBHOOK3_WORKSPACE=openclawd

HONCHO_WEBHOOK4_URL=https://solanaclawd.com/webhook4/chat
HONCHO_WEBHOOK4_SECRET=hch-webhook-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HONCHO_WEBHOOK4_WORKSPACE=solanaos
