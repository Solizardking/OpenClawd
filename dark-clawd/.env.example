# ─── Solana ─────────────────────────────────────────────────────────────────
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# ─── Market Data ────────────────────────────────────────────────────────────
BIRDEYE_API_KEY=

# ─── AI Providers ───────────────────────────────────────────────────────────
XAI_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=

# ─── Trading (Jupiter Swap API) ─────────────────────────────────────────────
# Get a key at https://developers.jup.ag/portal for higher rate limits.
# Required for live swaps via /swap, /buy, /sell agent commands and `dark-ralph swap`.
JUPITER_API_KEY=

# ─── News & Search ──────────────────────────────────────────────────────────
NEWS_API_KEY=
SERP_API_KEY=
FINANCIAL_DATASET_API_KEY=

# ─── Wallet (optional, for headless trading) ────────────────────────────────
# JSON array form (e.g. "[12,34,...]"). If unset, the wallet at ~/.darkralph/wallet.json
# created via `dark-ralph wallet --create` is used.
SOLANA_PRIVATE_KEY=
