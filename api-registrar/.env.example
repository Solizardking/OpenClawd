# OpenClawd API Registrar environment template.
# Copy to `.env` for local development. Do not commit populated `.env` files.

# Database (PostgreSQL/Neon)
DATABASE_URL=postgresql://user:password@host:5432/solanaclawd?sslmode=require

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# X (Twitter) API for tweet verification
X_API_BEARER_TOKEN=

# Internal secret for ClawdRouter validation
CLAWDROUTER_INTERNAL_SECRET=

# OpenClawd ecosystem endpoints
OPENCLAWD_API_BASE=https://solanaclawd.com/api
OPENCLAWD_HUB_URL=https://hub.solanaclawd.com
OPENCLAWD_MARKETPLACE=https://hub.solanaclawd.com/marketplace
OPENCLAWD_AGENTS_URL=https://hub.solanaclawd.com/agents
OPENCLAWD_SKILLS_URL=https://hub.solanaclawd.com/skills
OPENCLAWD_ROUTER_URL=https://solanaclawd.com/router
OPENCLAWD_DOCS_URL=https://solanaclawd.com/docs

# Optional registry override for `/api/acp/*`
ACP_REGISTRY_DIR=
