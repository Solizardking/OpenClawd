# ── Required ────────────────────────────────────────────────────────────────
# Google AI / Gemini API key — get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Solana RPC endpoint (Helius, QuickNode, public mainnet, etc.)
SOLANA_RPC_URL=

# ── Signing (enables send_solana_transaction, execute_x402_request) ─────────
# Base58-encoded 64-byte Solana private key.
# KEEP THIS SECRET — never commit it, never share it.
# The agent loads this server-side; it is never passed to the LLM.
SOLANA_PRIVATE_KEY=

# Corresponding public key (derived automatically if omitted, but faster to set)
SOLANA_PUBLIC_KEY=

# ── pay.sh gateway (optional) ────────────────────────────────────────────────
# Override if you run a self-hosted pay.sh gateway
PAY_GATEWAY_URL=https://pay.anthropic.tools

# ── Server mode (optional — only needed when running server.ts) ─────────────
# Port for the HTTP server
PORT=8080

# x402 facilitator URL for payment verification
FACILITATOR_URL=

# Price (in lamports) per /api/* call when running as an x402 provider
X402_PRICE_LAMPORTS=5000
